{
    "compilerOptions": {
      "target": "ESNext",
      "useDefineForClassFields": false,
      "module": "commonjs",
      "rootDir": "./src",
      "moduleResolution": "node",
      "allowJs": true,
      "outDir": "./dist",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": false,
      "strict": true,
      "skipLibCheck": true
    },
    "include": ["src/**/*", "src/services"],
    "exclude": ["node_modules"]
  }